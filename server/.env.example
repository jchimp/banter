# --- storage -----------------------------------------------------------------
DATA_DIR=/data
# Reject uploads larger than this many bytes (default 10MiB).
MAX_UPLOAD_BYTES=10485760

# --- auth --------------------------------------------------------------------
# Shared secret the kidbox sends as X-API-Key.  Generate:  openssl rand -hex 24
API_KEY=changeme-generate-a-real-one

# --- selection algorithm (PRD 3.3) ------------------------------------------
PARENT_COOLDOWN_HOURS=12
AVOID_IMMEDIATE_REPEAT=true

# --- telegram (used from M3; blank = bot disabled) --------------------------
# Bot token from @BotFather. Chat ids: message the bot, then read
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_MOM=
TELEGRAM_CHAT_DAD=

# --- misc --------------------------------------------------------------------
LOG_LEVEL=INFO

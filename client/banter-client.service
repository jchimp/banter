[Unit]
Description=Banter kidbox client
After=network-online.target sound.target
Wants=network-online.target

[Service]
# User and paths assume the `pi` account. A Pi 4 image's default user is whatever
# Imager was told, so User=, WorkingDirectory=, EnvironmentFile= and the uv path
# all have to be changed together to match it (and BANTER_QUEUE_DIR/_CACHE_DIR).
Type=simple
User=pi
WorkingDirectory=/home/pi/banter/client
EnvironmentFile=/home/pi/banter/client/.env
ExecStart=/home/pi/.local/bin/uv run --no-dev banter-client
Restart=on-failure
RestartSec=3
# __main__.py handles SIGTERM and shuts the uploader thread down within a few
# seconds (thread join timeout=5), so a short stop timeout is safe and keeps a
# restart snappy instead of waiting out systemd's 90s default.
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
# No ProtectSystem=strict / PrivateDevices=yes here on purpose: this unit needs
# /dev/gpiochip*, /dev/snd/*, and /dev/spidev* for buttons, audio, and the ring.

[Install]
WantedBy=multi-user.target

# Laptop / dev-box profile — no Pi, no Codec Zero.
#   cp .env.dev.example .env && uv sync --extra dev-audio && uv run banter-demo
# Uses your built-in mic and speakers. Swap sounddevice -> synthetic for no audio at all.
BANTER_AUDIO_BACKEND=sounddevice
BANTER_BUTTON_BACKEND=keyboard
BANTER_RING_BACKEND=terminal

BANTER_API_URL=http://localhost:8080
BANTER_API_KEY=changeme-must-match-server-API_KEY
BANTER_DEVICE_ID=kidbox-dev
BANTER_HTTP_TIMEOUT=30.0

BANTER_SAMPLE_RATE=16000
BANTER_MAX_SECONDS=60
BANTER_MIN_SECONDS=0.8

# The keyboard backend has no concept of a hold, so it's always toggle regardless
# of this setting — kept here so it matches the server profile and .env.example.
BANTER_BUTTON_MODE=hold

BANTER_QUEUE_DIR=./devdata/queue
BANTER_CACHE_DIR=./devdata/cache

# Upload retry (queue.py/uploader.py) — same defaults as the Pi profile.
BANTER_BACKOFF_START_SECONDS=2.0
BANTER_BACKOFF_MAX_SECONDS=60.0

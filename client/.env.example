# --- server ------------------------------------------------------------------
BANTER_API_URL=http://homeserver.local:8080
BANTER_API_KEY=changeme-must-match-server-API_KEY
BANTER_DEVICE_ID=kidbox-01
# Whole-request budget for an audio download (a 60s clip over weak WiFi).
BANTER_HTTP_TIMEOUT=30.0
# /next and /played are tiny JSON calls. Kept short so BTN2 falls back to the play
# cache quickly when the server is down but the TCP connection still gets accepted.
BANTER_NEXT_TIMEOUT=3.0
# After a failed fetch, skip the network entirely for this long and go straight to
# cache — only the first tap of an outage pays a timeout.
BANTER_OFFLINE_MEMO_SECONDS=30.0

# --- backends ----------------------------------------------------------------
# Pi:      alsa / gpio      / neopixel
# Laptop:  sounddevice / keyboard / terminal
# CI:      synthetic   / keyboard / null
BANTER_AUDIO_BACKEND=alsa
BANTER_BUTTON_BACKEND=gpio
BANTER_RING_BACKEND=neopixel

# --- audio (find these with `arecord -l` and `aplay -l`) ---------------------
# This is the Zero 2 W + Codec Zero build, where both live on card 0. For the
# Pi 4 + USB webcam/speaker build start from .env.pi4.example instead.
BANTER_ALSA_CAPTURE=plughw:0,0
BANTER_ALSA_PLAYBACK=plughw:0,0
BANTER_SAMPLE_RATE=16000
# Optional: put the mixer at a known level at startup so every boot sounds the same.
# Control names are per card: `amixer -c 0 scontrols` lists them. Empty = leave alone.
BANTER_ALSA_PLAYBACK_CONTROL=
BANTER_ALSA_PLAYBACK_PERCENT=80
BANTER_ALSA_CAPTURE_CONTROL=
BANTER_ALSA_CAPTURE_PERCENT=80

# --- buttons (BCM numbering; see wiring.svg) --------------------------------
BANTER_PIN_RECORD=17
BANTER_PIN_PLAY=22
# BTN3 replays the last clip this box kept (a local copy, so it survives the upload).
# Same pin on both builds: the Codec Zero HAT doesn't use GPIO5 (physical pin 29).
BANTER_PIN_REPLAY=5
BANTER_BUTTON_MODE=hold
BANTER_BOUNCE_SECONDS=0.05

# --- recording limits --------------------------------------------------------
BANTER_MAX_SECONDS=60
BANTER_MIN_SECONDS=0.8
# BTN1 must stay pressed this long before the beep + capture start. A shorter press is
# ignored outright (event=record_ignored reason=tap). 0 disables.
BANTER_RECORD_ARM_SECONDS=0.25
# Silence / low-content gate. Every clip logs peak_dbfs, floor_dbfs and voiced so you
# can tune these from `journalctl -u banter-client`: raise SILENCE_DBFS if quiet-room
# clips get through, lower it if real jokes log reason=silent.
#   SILENCE_DBFS        loudest sample under this -> reason=silent
#   VOICE_MARGIN_DB     a 100 ms window counts as voiced only this far above the clip's
#                       own noise floor (a fan hum has no headroom; speech does). 0 = off.
#   MIN_VOICED_SECONDS  fewer voiced seconds -> reason=low_content. 0 = off.
BANTER_SILENCE_DBFS=-45
BANTER_VOICE_MARGIN_DB=6
BANTER_MIN_VOICED_SECONDS=0.5
# After a kept clip: pause this long past the success flash, then play the clip straight
# back (the same local copy BTN3 uses). 0 = off.
BANTER_AUTO_REPLAY_SECONDS=0.5

# --- tones -------------------------------------------------------------------
# "Go ahead" beep right before capture, falling double-blip on a discard. Played
# through BANTER_ALSA_PLAYBACK; generated at startup into $BANTER_CACHE_DIR/tones.
BANTER_TONES=true
BANTER_TONE_VOLUME=0.5

# --- playback leveling (leveling.py) -----------------------------------------
# Every clip the box plays (play cache, BTN3/auto-replay copy) is gained once, when
# written, so its voiced RMS lands at TARGET_DBFS. The queued upload and the server
# archive are untouched. The tones at TONE_VOLUME=0.5 sit near -9 dBFS, so -16 puts
# speech alongside them. Each clip logs event=leveled gain_db=... for tuning.
# MAX_GAIN_DB caps the boost so a near-silent clip is not raised into hiss.
BANTER_PLAY_LEVELING=true
BANTER_PLAY_TARGET_DBFS=-16
BANTER_PLAY_MAX_GAIN_DB=20

# --- ring --------------------------------------------------------------------
BANTER_RING_PIXELS=16
BANTER_LED_MAX_BRIGHTNESS=0.3
BANTER_IDLE_GLOW=false

# --- local storage -----------------------------------------------------------
# Assumes the `pi` account. If your user is anything else — or the app lives outside
# a home dir, e.g. /opt/banter — change both paths and the User= in
# banter-client.service together, or startup dies on a PermissionError.
BANTER_QUEUE_DIR=/home/pi/banter-queue
# On-disk LRU cache of the last N played clips (BANTER_PLAY_CACHE_SIZE), used as the
# BTN2 offline fallback when the server is unreachable (PRD FR-12).
BANTER_CACHE_DIR=/home/pi/banter-cache
BANTER_PLAY_CACHE_SIZE=10

# --- upload retry (queue.py/uploader.py; exponential backoff, indefinite) ----
BANTER_BACKOFF_START_SECONDS=2.0
BANTER_BACKOFF_MAX_SECONDS=60.0

# --- heartbeat (heartbeat.py; fixed interval, no backoff) --------------------
BANTER_HEARTBEAT_INTERVAL_SECONDS=60.0

# Pi 4 profile — USB webcam mic + USB speaker, no HAT.
#   cp .env.pi4.example .env   then fill in the two ALSA names below.
# Same backends as the Zero/Codec Zero build: only the device strings differ. The
# buttons and ring are unchanged (GPIO17/22, GPIO10) — with no HAT in the way they
# wire straight to the header, so no splitter and no ribbon.

# --- server ------------------------------------------------------------------
BANTER_API_URL=http://homeserver.local:8080
BANTER_API_KEY=changeme-must-match-server-API_KEY
BANTER_DEVICE_ID=kidbox-01
BANTER_HTTP_TIMEOUT=30.0
BANTER_NEXT_TIMEOUT=3.0
BANTER_OFFLINE_MEMO_SECONDS=30.0

# --- backends ----------------------------------------------------------------
BANTER_AUDIO_BACKEND=alsa
BANTER_BUTTON_BACKEND=gpio
BANTER_RING_BACKEND=neopixel

# --- audio -------------------------------------------------------------------
# Two USB audio gadgets means two cards, and their indices swap across reboots —
# don't use plughw:1,0 here. Run `arecord -L` and `aplay -L`, take the stable
# plughw:CARD=<name>,DEV=0 forms, and paste them in. The plug layer converts the
# webcam's native 48 kHz stereo down to the 16 kHz mono the server wants.
# The client checks both of these at startup and logs event=alsa_device_missing
# with the cards it can actually see if one is wrong.
BANTER_ALSA_CAPTURE=plughw:CARD=Webcam,DEV=0
BANTER_ALSA_PLAYBACK=plughw:CARD=Speaker,DEV=0
BANTER_SAMPLE_RATE=16000

# --- buttons (BCM numbering; see wiring.svg) --------------------------------
BANTER_PIN_RECORD=17
BANTER_PIN_PLAY=22
BANTER_BUTTON_MODE=hold
BANTER_BOUNCE_SECONDS=0.05

# --- recording limits --------------------------------------------------------
BANTER_MAX_SECONDS=60
BANTER_MIN_SECONDS=0.8

# --- ring --------------------------------------------------------------------
# Still SPI0 MOSI on GPIO10: dtparam=spi=on and core_freq_min=500 apply here too.
BANTER_RING_PIXELS=16
BANTER_LED_MAX_BRIGHTNESS=0.3
BANTER_IDLE_GLOW=false

# --- local storage -----------------------------------------------------------
# A Pi 4 image's default user is whatever you told Imager — not necessarily `pi`.
# These paths and banter-client.service must agree with it.
BANTER_QUEUE_DIR=/home/pi/banter-queue
BANTER_CACHE_DIR=/home/pi/banter-cache
BANTER_PLAY_CACHE_SIZE=10

# --- upload retry ------------------------------------------------------------
BANTER_BACKOFF_START_SECONDS=2.0
BANTER_BACKOFF_MAX_SECONDS=60.0

# --- heartbeat ---------------------------------------------------------------
BANTER_HEARTBEAT_INTERVAL_SECONDS=60.0

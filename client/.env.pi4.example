# Pi 4 profile — USB webcam mic + USB speaker, no HAT.
#   cp .env.pi4.example .env   then fill in the two ALSA names below.
# Same backends as the Zero/Codec Zero build. With no HAT in the way the controls wire
# straight to the header, so no splitter and no ribbon. Two things do differ from the
# Codec Zero profile: the two ALSA device strings, and BTN2 — GPIO22 is dead on this
# board, so play is on GPIO27 (see the buttons section below).

# --- server ------------------------------------------------------------------
BANTER_API_URL=http://homeserver.local:8080
BANTER_API_KEY=changeme-must-match-server-API_KEY
BANTER_DEVICE_ID=kidbox-01
BANTER_HTTP_TIMEOUT=30.0
BANTER_NEXT_TIMEOUT=3.0
BANTER_OFFLINE_MEMO_SECONDS=30.0

# --- backends ----------------------------------------------------------------
BANTER_AUDIO_BACKEND=alsa
BANTER_BUTTON_BACKEND=gpio
# The ring is not wired on this build yet (M5). Left as `null` on purpose rather than
# `neopixel`: with no ring attached the box gives no feedback at all for recording
# started, clip discarded, upload queued, or nothing-to-play — so treat it as a
# supervised device until the ring lands. Flip to `neopixel` once the 16 LEDs are on
# GPIO10 and `dtparam=spi=on` is set.
BANTER_RING_BACKEND=null

# --- audio -------------------------------------------------------------------
# Two USB audio gadgets means two cards, and their indices swap across reboots —
# don't use plughw:1,0 here. Run `arecord -L` and `aplay -L`, take the stable
# plughw:CARD=<name>,DEV=0 forms, and paste them in. The plug layer converts the
# webcam's native 48 kHz stereo down to the 16 kHz mono the server wants.
# The client checks both of these at startup and logs event=alsa_device_missing
# with the cards it can actually see if one is wrong.
BANTER_ALSA_CAPTURE=plughw:CARD=Webcam,DEV=0
BANTER_ALSA_PLAYBACK=plughw:CARD=Speaker,DEV=0
BANTER_SAMPLE_RATE=16000

# --- buttons (BCM numbering; see wiring.svg) --------------------------------
# BTN2 is on 27 here, not the 22 that wiring.svg and the Codec Zero profile show.
# On this particular Pi 4, GPIO22 read pressed at rest and pressing produced no edge
# in either direction; swapping the two physical buttons kept the fault on the pin,
# not the button. gpiozero fires on a high->low edge, so a line already low at boot
# means the play button is silent with no log line at all — see the startup preflight
# in __main__.py. 27 is free only because the Pi 4 build has no HAT; on the Codec Zero
# it is the HAT's own button, so do NOT copy this value into .env.example.
# Board-specific workaround, not a design change.
BANTER_PIN_RECORD=17
BANTER_PIN_PLAY=27
BANTER_BUTTON_MODE=hold
BANTER_BOUNCE_SECONDS=0.05

# --- recording limits --------------------------------------------------------
BANTER_MAX_SECONDS=60
BANTER_MIN_SECONDS=0.8

# --- ring --------------------------------------------------------------------
# Still SPI0 MOSI on GPIO10: dtparam=spi=on and core_freq_min=500 apply here too.
BANTER_RING_PIXELS=16
BANTER_LED_MAX_BRIGHTNESS=0.3
BANTER_IDLE_GLOW=false

# --- local storage -----------------------------------------------------------
# Replace <user> — a Pi 4 image's default user is whatever you told Imager, not
# necessarily `pi`, and these must be writable by whoever banter-client.service runs
# as. Left as a placeholder on purpose: a wrong path here fails at startup with a
# PermissionError on someone else's home directory.
# Installing under /opt? Use a shared dir instead:
#   sudo install -d -o <user> -g <user> /var/lib/banter/queue /var/lib/banter/cache
BANTER_QUEUE_DIR=/home/<user>/banter-queue
BANTER_CACHE_DIR=/home/<user>/banter-cache
BANTER_PLAY_CACHE_SIZE=10

# --- upload retry ------------------------------------------------------------
BANTER_BACKOFF_START_SECONDS=2.0
BANTER_BACKOFF_MAX_SECONDS=60.0

# --- heartbeat ---------------------------------------------------------------
BANTER_HEARTBEAT_INTERVAL_SECONDS=60.0
